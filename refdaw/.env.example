# Copy to .env (setup.sh does this) and fill in what you have. Restart ./run.sh after changes.

# Required for the assistant (voice/text editing): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Eleven Music generation + server-side speech-to-text: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: ACE-Step audio-to-audio generation on fal.ai: https://fal.ai/dashboard/keys
FAL_KEY=

# Optional overrides
# REFDAW_MODEL=claude-opus-5-5
# REFDAW_ELEVEN_MODEL=music_v1
# REFDAW_FAL_ENDPOINT=fal-ai/ace-step/audio-to-audio
# REFDAW_STT_MODEL=scribe_v1
# REFDAW_PORT=8765
